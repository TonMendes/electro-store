<div class="card">
    <div class="card-body">
      <h5 class="card-title">Produtos Cadastrados</h5>

      {{#if produtos}}
        <table class="table table-striped table-hover align-middle">
          <thead>
            <tr>
              <th>Categoria</th>
              <th>Nome</th>
              <th>Qtd.</th>
              <th>Preço</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            {{#each produtos}}
              <tr>
                <td>{{categoria.nome}}</td>
                <td>{{nome}}</td>
                <td>{{quantidade}}</td>
                <td>R$ {{preco}}</td>
                <td>
                  <a href="/produtos/consulta/{{id}}" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-eye"></i> Consultar
                  </a>
                  {{#if (eq ../user.perfil 'lojista')}}
                    {{#if quantidade}}
                      <form method="POST" action="/produtos/venda/{{id}}" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger">
                          <i class="bi bi-cart-dash"></i> Registrar Venda
                        </button>
                      </form>
                    {{/if}}
                    <form method="POST" action="/produtos/compra/{{id}}" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-success">
                        <i class="bi bi-cart-plus"></i> Registrar Compra
                      </button>
                    </form>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p class="text-muted">Nenhum produto cadastrado no momento.</p>
      {{/if}}
    </div>
  </div>